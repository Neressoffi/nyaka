# Copier ce fichier en .env.local (jamais commité, voir .gitignore) et remplir les valeurs.

# Clé API Anthropic (console.anthropic.com). Ne jamais exposer côté client.
ANTHROPIC_API_KEY=

# Optionnel : modèle Claude utilisé par l'assistant. Par défaut claude-haiku-4-5-20251001.
# CLAUDE_MODEL=claude-haiku-4-5-20251001

# Origine autorisée pour les appels à /api/chat (CORS). localhost est toujours autorisé.
SITE_ORIGIN=https://www.nyakaagency.com

# Google Sheets (enregistrement des demandes) — voir README pour créer le compte de service.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# La clé privée contient des sauts de ligne : coller la valeur telle quelle (avec les "\n").
GOOGLE_PRIVATE_KEY=

# Numéro WhatsApp affiché dans le widget (fictif par défaut). Format international sans "+".
# Visible côté navigateur (NEXT_PUBLIC_) : ce n'est qu'un numéro de téléphone, pas un secret.
NEXT_PUBLIC_WHATSAPP_NUMBER=000000000000
